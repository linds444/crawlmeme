# Copy to .env and fill in. Never commit .env: it holds API keys. Every key stays server-side (RPC URLs are never
# logged, never sent to the browser).

# --- RPC providers -----------------------------------------------------------------------------------------------
# Robinhood Chain (4663). Empty: the public endpoint is used (full log history, no historical state, 8 RPS).
CRAWLER_RPC=
CRAWLER_RPS=8
# Alchemy key, used for Robinhood, BNB Chain and Base. Free tier: eth_getLogs over 10 blocks only, but the Transfers
# API (alchemy_getAssetTransfers) gives full token and wallet history; that is what makes older BNB/Base tokens scannable.
ALCHEMY_API_KEY=
ALCHEMY_TIER=free
ALCHEMY_RPS=10
# Extra endpoints per chain (comma-separated, tried before Alchemy and the public nodes), e.g. a paid archive node.
ROBINHOOD_RPC_URLS=
BSC_RPC_URLS=
BASE_RPC_URLS=
# Solana: SOLANA_RPC, or HELIUS_API_KEY (builds the Helius mainnet URL). The public Solana RPC rate-limits the calls
# holder reconstruction needs, so a key is required for real Solana scans.
SOLANA_RPC=
HELIUS_API_KEY=
SOLANA_RPS=8
HELIUS_ENHANCED_RPS=5      # Helius parsed history (Solana wallet histories and funding), calls/sec
HOLDERS_MAX=100000         # Solana: token accounts read for the full holder list
# Background work (alerts rechecks, indexes) gets at most this many requests/sec per adapter.
BACKGROUND_RPS=2

# --- Chains and launchpads (all off by default: V1 behaviour = Robinhood Pons only) ----------------------------------
SOLANA_ENABLED=false
BSC_ENABLED=false
BASE_ENABLED=false
FLAP_ENABLED=false          # Flap on Robinhood and on BNB Chain
BANKR_ENABLED=false         # Bankr on Robinhood
BANKR_INDEX_ENABLED=false
BANKR_INDEX_MAX_ENTRIES=500000
CLANKER_ENABLED=false       # Clanker v4 on Robinhood, BNB Chain and Base
FOURMEME_ENABLED=false      # four.meme on BNB Chain
DEX_ENABLED=false           # tokens launched straight into Uniswap (Robinhood, Base, BNB) or PancakeSwap (BNB) pools

# --- Scanning limits -----------------------------------------------------------------------------------------------
MAX_CONCURRENT=3
SCAN_QUEUE_MAX=6
SCAN_MAX_LOGS=150000
SCAN_CACHE_MAX_TRANSFERS=100000
TRANSFER_CACHE_ENABLED=false
SCAN_RATE_PER_MIN=10
SCAN_DEPTH=20               # top holders examined per scan (5..100; 20 = V1 methodology)
SCAN_RATE_BOT_PER_MIN=120
MEMORY_SOFT_LIMIT_MB=
ESTABLISHED_MIN_AGE_DAYS=
ESTABLISHED_MIN_LIQUIDITY_USD=
ESTABLISHED_MIN_MCAP_USD=

# --- Storage -------------------------------------------------------------------------------------------------------
LOCAL_DB_PATH=              # SQLite for the feed and alerts (default ./data/crawl.db)
OPMEM_ENABLED=false
OPMEM_DB_PATH=
OPMEM_MIN_INTERVAL_H=6
REPLAY_ENABLED=false
HISTORY_INDEX=on            # resumable per-token transfer index (history.db next to LOCAL_DB_PATH); off = full re-read
INDEX_MAX_MB=512            # index size cap, least recently updated tokens evicted first

# --- Telegram bot and alerts ---------------------------------------------------------------------------------------
TG_BOT_TOKEN=
CRAWLSCAN_API=http://localhost:8000   # the bot talks to your own server, not crawlscan.fun
ALERTS_ENABLED=false
ALERTS_API_SECRET=
ALERTS_RECHECK_MIN=15
ALERTS_MAX_RECHECKS_PER_HOUR=60
TRADE_URL_ROBINHOOD=
TRADE_URL_SOLANA=

# --- Tests ---------------------------------------------------------------------------------------------------------
# CRAWLER_LIVE=1 runs the mainnet integration tests (tests/test_live_launchpads.py); CI stays offline.
